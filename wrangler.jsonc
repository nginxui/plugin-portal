{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nginxui-plugin-portal",
  // The account of the catalog Pages project and the release webhook.
  "account_id": "9b281dd2ab36041a82b8b35a7a14c5de",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "portal.nginxui.com", "custom_domain": true }],
  // Reminders for changes that wait on their author, and tracker email.
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal",
      "database_id": "aebdd686-03c1-4ef0-8146-adc51e848155",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PORTAL_ORIGIN": "https://portal.nginxui.com",
    "CATALOG_URL": "https://plugins.nginxui.com",
    "CATALOG_REPO": "nginxui/plugins",
    "CATALOG_APP_SLUG": "nginx-ui-plugin-catalog",
    "GITHUB_CLIENT_ID": "Iv23liIZ9byWbTtC8v83"
  },
  "env": {
    // portal-staging.nginxui.com, against the test catalog nginxui/plugins-staging.
    // Build and deploy with `bun run deploy:staging`.
    "staging": {
      "name": "nginxui-plugin-portal-staging",
      "routes": [{ "pattern": "portal-staging.nginxui.com", "custom_domain": true }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portal-staging",
          "database_id": "9d9781ae-fd46-4037-b823-f743de92de17",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "PORTAL_ORIGIN": "https://portal-staging.nginxui.com",
        "CATALOG_URL": "https://plugins.nginxui.com",
        "CATALOG_REPO": "nginxui/plugins-staging",
        "CATALOG_APP_SLUG": "nginx-ui-plugin-catalog",
        "GITHUB_CLIENT_ID": "Iv23liIZ9byWbTtC8v83",
        // The test catalog does not deploy; a workflow of its own sends the report.
        "DEPLOY_WORKFLOW": "report-deploy.yml"
      }
    }
  }
  // Secrets, set with `wrangler secret put <NAME>` (add `--env staging` for staging):
  //   GITHUB_CLIENT_SECRET  client secret of the Portal GitHub App
  //   SESSION_KEY           32 random bytes, base64, encrypts GitHub tokens
  //   DEPLOY_APP_ID         id of the NGINX UI Catalog Deploy App
  //   DEPLOY_APP_PRIVATE_KEY its private key, starts apply.yml
  // Optional, each turns a feature on:
  //   BOT_LOGIN, BOT_TOKEN  the machine user that opens store pull requests from its forks
  //   AI_KEY                32 random bytes, base64, encrypts AI provider keys apart from SESSION_KEY;
  //                         without it SESSION_KEY does, and keys sealed that way still open once it is set
  //   EMAIL_API_URL, EMAIL_API_KEY, EMAIL_FROM  tracker email through an HTTP mail API
  // Screenshot uploads need an R2 bucket bound as MEDIA, plugin-media in the spec.
}
