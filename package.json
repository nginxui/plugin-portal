{
  "name": "nginxui-plugin-portal",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply portal --local",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "gettext:extract": "vue-gettext-extract",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "db:migrate:staging": "wrangler d1 migrations apply portal-staging --remote --env staging",
    "db:migrate": "wrangler d1 migrations apply portal --remote",
    "strings:market": "node scripts/sync-market-strings.mjs"
  },
  "dependencies": {
    "@antdv-next/icons": "^1.1.2",
    "@vueuse/core": "^15.0.0",
    "antdv-next": "^1.6.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "marked": "^18.0.14",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue3-gettext": "4.0.1",
    "worker-mailer": "1.2.1"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.2.0",
    "@antfu/eslint-config": "^9.5.1",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@iconify-json/tabler": "^1.2.41",
    "@types/gettext-parser": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "gettext-parser": "^9.1.1",
    "typescript": "5.9.3",
    "unocss": "^66.10.5",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
